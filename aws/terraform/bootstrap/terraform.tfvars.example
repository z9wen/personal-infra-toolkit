# Copy to terraform.tfvars (git-ignored) and adjust.
region             = "ap-east-1"
project            = "infra-toolkit-links"
github_repository  = "z9wen/personal-infra-toolkit"
github_environment = "aws-demo"
budget_alert_email = "you@example.com"
monthly_budget_usd = 5

# Set to false if this AWS account already has the GitHub OIDC provider.
create_github_oidc_provider = true
